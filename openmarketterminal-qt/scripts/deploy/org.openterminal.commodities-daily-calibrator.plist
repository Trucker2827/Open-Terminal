<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Commodities daily strike calibrator — KXGOLDD / KXSILVERD / KXWTI.
  DOCUMENTED, NOT AUTO-LOADED — install by hand:

      cp org.openterminal.commodities-daily-calibrator.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/org.openterminal.commodities-daily-calibrator.plist

  ADVISORY / PAPER PATH ONLY.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>org.openterminal.commodities-daily-calibrator</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/haydarevich/src/Open-Terminal/openmarketterminal-qt/scripts/kalshi_advise/commodities_daily_calibrator.py</string>
    <string>once</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key><string>/Users/haydarevich/src/Open-Terminal/openmarketterminal-qt</string>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/haydarevich/Library/Application Support/org.openterminal.OpenTerminal/logs/commodities-daily-calibrator.out.log</string>
  <key>StandardErrorPath</key><string>/Users/haydarevich/Library/Application Support/org.openterminal.OpenTerminal/logs/commodities-daily-calibrator.err.log</string>
</dict></plist>
